{
  pkgs,
  lib,
  ...
}: let
  # Wallpapers come from the nix store, so they exist on every machine
  # regardless of where this repo is checked out.
  wallpapers = pkgs.runCommand "wallpapers" {} ''
    mkdir -p $out
    cp ${../../dotfiles/wallpaper}/*.jpg $out/
  '';
in {
  home.packages = [
    (pkgs.writeShellApplication {
      name = "random-wallpaper";
      bashOptions = [];
      text = ''
        shopt -s nullglob

        files=(${wallpapers}/*.jpg)
        count=''${#files[@]}

        if (( count == 0 )); then
          echo "No JPG files found in ${wallpapers}"
          exit 1
        fi

        ${pkgs.feh}/bin/feh --bg-scale "''${files[RANDOM % count]}"
      '';
    })

    # A random car wallpaper from wallhaven.cc (SFW, no API key needed).
    # `car-wallpaper` fetches and sets one; `car-wallpaper save` copies the
    # one currently shown into ~/Pictures/wallpapers/cars.
    (pkgs.writeShellApplication {
      name = "car-wallpaper";
      runtimeInputs = with pkgs; [curl jq feh libnotify coreutils gnused];
      text = ''
        cache="''${XDG_CACHE_HOME:-$HOME/.cache}/car-wallpaper"
        saved="$HOME/Pictures/wallpapers/cars"

        save() {
            # ~/.fehbg names the image on screen; only ours can be saved
            img=$(sed -n "s/.*'\(.*\)'.*/\1/p" "$HOME/.fehbg" 2>/dev/null | tail -1)
            case "$img" in
                "$cache"/*) ;;
                *) notify-send "Car wallpaper" "Current wallpaper is not a wallhaven one"; exit 1 ;;
            esac
            mkdir -p "$saved"
            cp "$img" "$saved/"
            notify-send "Car wallpaper" "Saved $(basename "$img")"
        }

        fetch() {
            api='https://wallhaven.cc/api/v1/search?q=cars&categories=100&purity=100&atleast=2560x1440&ratios=16x9&sorting=random'
            if ! url=$(curl -fsS --max-time 15 "$api" | jq -re '.data[0].path'); then
                notify-send "Car wallpaper" "Could not reach wallhaven.cc"
                exit 1
            fi
            mkdir -p "$cache"
            tmp=$(mktemp "$cache/.download.XXXXXX")
            if ! curl -fsS --max-time 60 -o "$tmp" "$url"; then
                rm -f "$tmp"
                notify-send "Car wallpaper" "Download failed"
                exit 1
            fi
            # keep only the one on screen
            find "$cache" -maxdepth 1 -name 'wallhaven-*' -delete
            img="$cache/$(basename "$url")"
            mv "$tmp" "$img"
            feh --bg-fill "$img"
        }

        case "''${1:-}" in
            save) save ;;
            *) fetch ;;
        esac
      '';
    })
  ];

  # betterlockscreen -l shows a pre-rendered image from ~/.cache/betterlockscreen,
  # which otherwise has to be generated by hand with `betterlockscreen -u`.
  # This regenerates the cache on login whenever it went stale. It must run
  # inside the graphical session because betterlockscreen queries X for the
  # resolution.
  #
  # The marker holds the wallpaper store path *and* the monitor layout: the
  # images are rendered once at whatever size X reported back then, so a cache
  # built on a 1080p screen stays 1080p - and comes out stretched - after the
  # machine moves to a 1440p one. Keying on the store path alone never noticed
  # that, which is how amd-desktop ended up locking with a 1920x1080 image
  # cached for a monitor (HDMI-0) it no longer has.
  systemd.user.services.betterlockscreen-cache = {
    Unit = {
      Description = "Generate betterlockscreen wallpaper cache";
      After = ["graphical-session.target"];
      PartOf = ["graphical-session.target"];
    };
    Service = {
      Type = "oneshot";
      ExecStart = lib.getExe (pkgs.writeShellApplication {
        name = "betterlockscreen-cache";
        runtimeInputs = [pkgs.xrandr pkgs.coreutils pkgs.gawk pkgs.betterlockscreen];
        bashOptions = [];
        text = ''
          marker="$HOME/.cache/betterlockscreen/.wallpaper-source"

          layout() {
            xrandr --listmonitors | awk 'NR > 1 {printf "%s:%s ", $2, $3}'
          }

          # Hosts that force a mode do it from i3's startup commands, which can
          # land after this unit starts. Wait for the layout to stop changing so
          # the cache is not rendered against the pre-xrandr mode.
          current=$(layout)
          for _ in $(seq 10); do
            sleep 2
            next=$(layout)
            [ "$next" = "$current" ] && break
            current=$next
          done

          key="${wallpapers} $current"
          if [ "$(cat "$marker" 2>/dev/null)" != "$key" ]; then
            betterlockscreen -u ${wallpapers} && printf '%s' "$key" >"$marker"
          fi
        '';
      });
    };
    Install.WantedBy = ["graphical-session.target"];
  };
}
