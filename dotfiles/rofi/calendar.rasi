/* Month calendar popped out from the polybar clock (right-click).
   Anchored to the top-centre of the monitor; the launcher script
   overrides x-offset so the window is centred under the pointer.
   y-offset clears the bar. The month grid is pre-rendered by `cal`,
   so the font must stay monospace or the columns fall apart.
   Every colour (and the corner radius) is env(ROFI_*, default). The @name@
   defaults are filled in from the palette in features/theme.nix when nix
   copies this file into the store (config.theme.rofiThemes). The Docky bar
   (features/polybar-docky.nix) exports its own, so anything rofi opens from
   that bar comes out in its colours without a second set of themes. The
   edge and y-offset are too: the bottom-docked Docky bar flips them to open
   the popup above itself. */

* {
    bg:        env(ROFI_BG, @bg@);
    bg-alt:    env(ROFI_BG_ALT, @bgAlt@);
    fg:        env(ROFI_FG, @fg@);
    primary:   env(ROFI_PRIMARY, @primary@);
    on-primary: env(ROFI_ON_PRIMARY, @onPrimary@);
    radius:    env(ROFI_RADIUS, 4px);
    disabled:  env(ROFI_DISABLED, @disabled@);

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 13";
}

window {
    location: env(ROFI_POPUP_SIDE, north);
    anchor:   env(ROFI_POPUP_SIDE, north);
    y-offset: env(ROFI_POPUP_Y, 40px);
    /* cal's grid is 20 monospace chars wide; at 13pt JetBrainsMono that is
       ~198px, plus the paddings and border below. Widening past that just
       leaves a gap to the right of the block, since the textbox is
       left-aligned (per-line centring would stagger the columns). */
    width:    240px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: @radius;
    padding: 10px;
}

mainbox {
    children: [message];
}

message, error-message {
    background-color: @bg-alt;
    border-radius: @radius;
    padding: 8px;
}

textbox {
    horizontal-align: 0.0;
    text-color: @fg;
}
