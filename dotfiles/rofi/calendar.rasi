/* Month calendar popped out from the polybar clock (right-click).
   Anchored to the top-centre of the monitor; the launcher script
   overrides x-offset so the window is centred under the pointer.
   y-offset clears the bar. The month grid is pre-rendered by `cal`,
   so the font must stay monospace or the columns fall apart.
   Every colour (and the corner radius) is env(ROFI_*, default): the defaults
   are the main bar's palette, and the Docky bar (features/polybar-docky.nix)
   exports its own, so anything rofi opens from that bar comes out in its
   colours without a second set of themes. The edge and y-offset are too:
   the bottom-docked Docky bar flips them to open the popup above itself. */

* {
    bg:        env(ROFI_BG, #282A2E);
    bg-alt:    env(ROFI_BG_ALT, #373B41);
    fg:        env(ROFI_FG, #C5C8C6);
    primary:   env(ROFI_PRIMARY, #F0C674);
    on-primary: env(ROFI_ON_PRIMARY, #282A2E);
    radius:    env(ROFI_RADIUS, 4px);
    disabled:  env(ROFI_DISABLED, #707880);

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 13";
}

window {
    location: env(ROFI_POPUP_SIDE, north);
    anchor:   env(ROFI_POPUP_SIDE, north);
    y-offset: env(ROFI_POPUP_Y, 40px);
    /* cal's grid is 20 monospace chars wide; at 13pt JetBrainsMono that is
       ~198px, plus the paddings and border below. Widening past that just
       leaves a gap to the right of the block, since the textbox is
       left-aligned (per-line centring would stagger the columns). */
    width:    240px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: @radius;
    padding: 10px;
}

mainbox {
    children: [message];
}

message, error-message {
    background-color: @bg-alt;
    border-radius: @radius;
    padding: 8px;
}

textbox {
    horizontal-align: 0.0;
    text-color: @fg;
}
