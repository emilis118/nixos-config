/* "Are you sure?" after picking a power menu action. */

@import "colors.rasi"

* {
    background-color: @bg;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:         250px;
    padding:       25px;
    border:        0px 0px 2px 0px;
    border-radius: 0px;
    border-color:  @ac;
    location:      center;
    y-offset:      -2em;
}

mainbox {
    children: [ inputbar ];
}

inputbar {
    children: [ prompt, entry ];
}

entry {
    expand:     true;
    text-color: @ac;
}
