/* rofi theme matching the polybar colors (dotfiles/i3/polybar.ini)
   Every colour (and the corner radius) is env(ROFI_*, default). The @name@
   defaults are filled in from the palette in features/theme.nix when nix
   copies this file into the store (config.theme.rofiThemes). The Docky bar
   (features/polybar-docky.nix) exports its own, so anything rofi opens from
   that bar comes out in its colours without a second set of themes. */

* {
    bg:        env(ROFI_BG, @bg@);
    bg-alt:    env(ROFI_BG_ALT, @bgAlt@);
    fg:        env(ROFI_FG, @fg@);
    primary:   env(ROFI_PRIMARY, @primary@);
    secondary: env(ROFI_SECONDARY, @secondary@);
    alert:     env(ROFI_ALERT, @alert@);
    on-primary: env(ROFI_ON_PRIMARY, @onPrimary@);
    radius:    env(ROFI_RADIUS, 4px);
    disabled:  env(ROFI_DISABLED, @disabled@);

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: @radius;
    padding: 10px;
    width: 42%;
}

mainbox {
    spacing: 8px;
    /* message must stay in the list: rofi-calc shows the live result there */
    children: [inputbar, message, listview, mode-switcher];
}

inputbar {
    background-color: @bg-alt;
    border-radius: @radius;
    padding: 8px 10px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: @primary;
}

entry {
    placeholder: "search...";
    placeholder-color: @disabled;
}

listview {
    lines: 10;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding: 6px 10px;
    spacing: 10px;
    border-radius: @radius;
}

element-icon {
    size: 1.2em;
}

element-text {
    text-color: inherit;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @primary;
}

element normal.urgent, element selected.urgent {
    text-color: @alert;
}

element normal.active, element selected.active {
    text-color: @secondary;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding: 6px;
    border-radius: @radius;
    background-color: @bg-alt;
    text-color: @disabled;
}

button selected {
    background-color: @primary;
    text-color: @on-primary;
}

message {
    background-color: @bg-alt;
    border-radius: @radius;
    padding: 8px;
}

textbox {
    text-color: @fg;
}

error-message {
    background-color: @bg;
    border: 2px;
    border-color: @alert;
    padding: 10px;
}
