/* Volume applet in the adi1090x style: one row of icon buttons.
   Anchored to the monitor's top-right; the launcher script overrides
   x-offset so the window's right edge lands under the pointer (the
   click on the polybar volume icon). y-offset clears the bar. */

* {
    bg:        #282A2E;
    bg-alt:    #373B41;
    fg:        #C5C8C6;
    primary:   #F0C674;
    alert:     #A54242;
    disabled:  #707880;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 14";
}

window {
    location: northeast;
    anchor:   northeast;
    y-offset: 40px;
    width:    320px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: 4px;
    padding: 10px;
}

mainbox {
    spacing: 8px;
    children: [message, listview];
}

message {
    background-color: @bg-alt;
    border-radius: 4px;
    padding: 6px;
}

textbox {
    horizontal-align: 0.5;
    text-color: @primary;
}

listview {
    lines: 1;
    columns: 5;
    spacing: 8px;
    fixed-height: true;
}

element {
    padding: 10px 0px;
    border-radius: 4px;
    background-color: @bg-alt;
    cursor: pointer;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}

element selected.normal {
    background-color: @primary;
    text-color: @bg;
}

/* muted buttons are passed as urgent rows */
element normal.urgent, element alternate.urgent {
    text-color: @alert;
}

element selected.urgent {
    background-color: @alert;
    text-color: @bg;
}
